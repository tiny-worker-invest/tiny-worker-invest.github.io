---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { SITE } from '../site.config';
---
<Base title="About" description={`About ${SITE.title}.`}>
  <article class="post prose">
    <h1>About</h1>
    <p>Hi, I'm a salaried office worker in Korea who has been investing in US stocks on the side for years.
      I started writing on my Korean blog and YouTube channel to keep my own analysis honest — this site brings
      that work to English-speaking readers.</p>
    <p>Expect earnings recaps, company deep dives, ETF comparisons and the occasional portfolio update,
      written from the perspective of a long-term individual investor rather than a Wall Street analyst.</p>
