---
// Lightweight YouTube embed (privacy-enhanced domain, lazy-loaded)
const { id, title = 'YouTube video' } = Astro.props as { id: string; title?: string };
---
<div class="video">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={title}
    loading="lazy"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
</div>
